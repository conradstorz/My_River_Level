# Per-Dockerfile ignore for Dockerfile.test. Only BuildKit honours it; the
# classic builder falls back to .dockerignore, which therefore also keeps
# tests/ in the context. Kept in sync with .dockerignore.

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/

# Logs
logs/

# Database files
*.db

# Git
.git/
.gitignore

# Development
docs/
.worktrees/

# Environment
.env
