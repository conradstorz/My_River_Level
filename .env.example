# River Monitor — environment variables
# Copy to .env (gitignored) and fill in real values. docker-compose reads this
# file automatically. The `river` password must match RIVER_DB_PASSWORD in the
# shared-postgres project's .env.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(24))"  # for FLASK_SECRET_KEY

# PostgreSQL on the shared-postgres server (hostname `postgres` in Docker).
# For host-side runs use localhost; for production use your managed DB URL.
DATABASE_URL=postgresql://river:<river-db-password>@postgres:5432/rivermonitor

# Test database on the same shared server (used by the Docker test suite).
TEST_DATABASE_URL=postgresql://river:<river-db-password>@postgres:5432/river_test

# Flask session signing key — generate a random value.
FLASK_SECRET_KEY=change-me-to-a-random-string

# Portal login (HTTP Basic). REQUIRED — without a password the admin pages
# refuse every request with 503 rather than falling open, because those pages
# show and accept your Telegram, Twilio, and Facebook credentials.
#
# IMPORTANT: a werkzeug hash is 'method$salt$hash', and docker compose
# interpolates '$name' in this file, so every '$' below must be written
# twice. Do NOT hand-escape it in a shell one-liner: in PowerShell a doubled
# '$' is the automatic 'last token of previous command' variable and expands
# to nothing, which silently deletes the separators. A hash with no separators
# matches no password at all.
#
# Use the generator, which prompts without echo and rewrites this key in .env
# already escaped:
#
#   uv run --with werkzeug python set_admin_password.py
#
# To confirm it survived into the container:
#
#   docker inspect my_river_level-app-1 --format '{{range .Config.Env}}{{println .}}{{end}}' | grep ADMIN_PASSWORD_HASH
#
# should show single '$' separators, two of them. If the app logs
# 'ADMIN_PASSWORD_HASH is not a valid werkzeug hash' at startup, they were eaten.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Telegram (leave blank to disable)
# TELEGRAM_BOT_TOKEN=

# Twilio SMS (leave blank to disable)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_NUMBER=+1xxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx

# Facebook Messenger (leave blank to disable)
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_VERIFY_TOKEN=
