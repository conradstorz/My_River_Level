# River Monitor — environment variables
# Copy to .env and fill in real values

# PostgreSQL. In Docker this is set by docker-compose.yml and points at the
# shared-postgres server (hostname `postgres`). Override here for other setups
# (e.g. a managed DB in production, or localhost when running on the host).
DATABASE_URL=postgresql://river:river@postgres:5432/rivermonitor

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string

# Telegram (leave blank to disable)
# TELEGRAM_BOT_TOKEN=

# Twilio SMS (leave blank to disable)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_NUMBER=+1xxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx

# Facebook Messenger (leave blank to disable)
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_VERIFY_TOKEN=

# Test database (used by pytest)
# TEST_DATABASE_URL=postgresql://river:river@localhost:5432/river_test
